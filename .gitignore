node_modules/
dist/
.DS_Store
coverage/
.vscode/

# block new binaries

*.ogg
*.zip
*.7z
*.tar
*.gz
*.pdf
*.psd
*.ai
*.woff*
*.ttf
*.otf
*.wasm

# allow committed portrait atlases in source and generated docs output
!src/assets/orcs/portraits/*.webp
!src/assets/orcs/portraits/*.png

# allow committed audio assets in source and generated docs output  
!src/assets/audio/*.mp3
!docs/audio/*.mp3

# ignore generated build artifacts in docs and public
docs/assets/
public/assets/
